# Copy to laundry_app/.env and fill in real values. Never commit the real file.

# SQLite for local development; swap to PostgreSQL for anything shared.
DATABASE_URL=sqlite:///laundry.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Flask SIGNS session cookies with this. There is NO in-code fallback: the app
# refuses to start when SECRET_KEY is missing, blank, or a known placeholder
# (so a forgeable session can never ship). Set a real, unique value here.
# The only exception is local development with DEBUG=true, where a random
# ephemeral key is generated per process (sessions reset on restart).
SECRET_KEY=

# Never enable outside local development -- it exposes the Werkzeug debugger.
# With DEBUG=true the app will also start without SECRET_KEY (ephemeral key).
DEBUG=False
